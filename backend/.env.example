DEEPAGENTS_DISABLE_BEDROCK_CACHE_MIDDLEWARE=true
DEBUG_ENABLED=True
MOTORPARTS_API_BASE_URL=
MOTORPARTS_API_TOKEN=
DATABASE_URL=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="erp-agent"

# API 鉴权token，选填，空值等价于None
MOTORPARTS_API_TOKEN=
MOTORPARTS_MODEL_BASE_URL=https://api-inference.modelscope.cn/v1
MOTORPARTS_MODEL_API_KEY=
# 使用的模型名称
#MOTORPARTS_AGENT_MODEL=openai:gpt-4.1-mini
MOTORPARTS_AGENT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Agent ID
MOTORPARTS_AGENT_ID=motorparts-agent

# RAG / Zilliz Cloud
# Milvus/Zilliz
ZILLIZ_URI=xxx
ZILLIZ_TOKEN=xxx
MILVUS_COLLECTION=motorparts_knowledge

# Embedding
#EMBED_MODEL=text-embedding-3-small
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIM=1536

# 父子块参数
PARENT_CHUNK_SIZE=1200
PARENT_OVERLAP=150
CHILD_CHUNK_SIZE=250
CHILD_OVERLAP=50
SEMANTIC_THRESHOLD=0.72

RAG_SOURCE_ROOT=doc
RERANKER_ENABLED=true
RERANKER_MODEL=maidalun1020/bce-reranker-base_v1

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
# Optional: also write logs to a file (default: backend/logs/app.log). Set to empty to disable.
# LOG_FILE=logs/app.log
