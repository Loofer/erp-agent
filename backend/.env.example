# --- Global System ---
DEBUG_ENABLED=True
LOG_LEVEL=DEBUG
# Optional: also write logs to a file (default: backend/logs/app.log). Set to empty to disable.
# LOG_FILE=logs/app.log

# --- Database ---
DATABASE_URL=

# --- MotorParts API Service ---
MOTORPARTS_API_BASE_URL=
MOTORPARTS_API_TOKEN=

# --- MotorParts LLM Model ---
MOTORPARTS_MODEL_BASE_URL=
MOTORPARTS_MODEL_API_KEY=
MOTORPARTS_AGENT_MODEL=
MOTORPARTS_AGENT_ID=motorparts-agent

# --- Embedding Config ---
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# --- RAG / Vector DB (Milvus/Zilliz) ---
ZILLIZ_URI=
ZILLIZ_TOKEN=
MILVUS_COLLECTION=


# --- RAG Chunk Splitting (Parent‑Child Chunk) ---
PARENT_CHUNK_SIZE=1200
PARENT_OVERLAP=150
CHILD_CHUNK_SIZE=250
CHILD_OVERLAP=50
SEMANTIC_THRESHOLD=0.72

# --- RAG Runtime & Reranker ---
RAG_SOURCE_ROOT=doc
RERANKER_ENABLED=true
RERANKER_MODEL=maidalun1020/bce-reranker-base_v1

# --- Cache (Redis) ---
# REDIS_URL=redis://127.0.0.1:6379/0

# --- LangSmith Tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="motorparts-agent"

# --- Evaluation Judge (optional) ---
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_BASE_URL=https://api.openai.com/v1
RAGAS_JUDGE_MODEL=gpt-5.4-mini
RAGAS_JUDGE_EMBEDDING_MODEL=text-embedding-3-small
